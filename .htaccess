# CampusMind (Apache / InfinityFree)
DirectoryIndex index.html
Options -Indexes

# never serve private or development files
<FilesMatch "(^\.|\.(md|bat|sqlite|sqlite-wal|sqlite-shm|sql|ini|log)$|^server\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
